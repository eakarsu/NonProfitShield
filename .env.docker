# Production Environment Variables for Docker Deployment
NODE_ENV=production

# Database Configuration
DATABASE_URL=postgresql://insurance_user:insurance_password@postgres:5432/insurance_platform
PGHOST=postgres
PGPORT=5432
PGUSER=insurance_user
PGPASSWORD=insurance_password
PGDATABASE=insurance_platform

# Session Configuration
SESSION_SECRET=your-secure-session-secret-change-this-in-production

# Authentication Configuration (Replit OAuth)
REPL_ID=insurance-platform
REPLIT_DOMAINS=localhost,127.0.0.1
ISSUER_URL=https://replit.com/oidc

# OpenRouter Configuration (required for AI damage assessment)
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Application Configuration
PORT=5000
HOST=0.0.0.0